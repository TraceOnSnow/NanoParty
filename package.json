{
  "name": "nanoparty",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @apr/server --filter @apr/web dev",
    "build": "pnpm --filter @apr/web build && pnpm --filter @apr/server build",
    "start": "pnpm --filter @apr/server start",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @apr/server db:generate",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
