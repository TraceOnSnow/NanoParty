{
  "name": "nanoparty",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @apr/server --filter @apr/web dev",
    "build": "pnpm --filter @apr/web build && pnpm --filter @apr/server build",
    "start": "pnpm --filter @apr/server start",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @apr/server db:generate",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "tester": "pnpm --filter @apr/server exec tsx --env-file-if-exists=../../.env tools/tester.ts",
    "host-replay": "pnpm --filter @apr/server exec tsx tools/host-replay.ts",
    "model-eval": "pnpm --filter @apr/server exec tsx --env-file-if-exists=../../.env tools/model-eval.ts",
    "dev:test": "pnpm --filter @apr/web build && cd apps/server && PORT=${PORT:-3100} TEST_MODE=true DATABASE_URL= PGLITE_DIR=${PGLITE_DIR:-../../data/test-pglite} pnpm exec tsx --env-file-if-exists=../../.env src/index.ts",
    "demo:build": "pnpm --filter @apr/web demo:build",
    "demo:preview": "pnpm --filter @apr/web demo:preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
