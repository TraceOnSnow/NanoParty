# ---------- 必填 ----------
# 实例管理员密码：创建房间时需要。至少 8 个字符，请使用足够长的随机字符串。
# 它不是邀请码，不要发给玩家。
ADMIN_PASSWORD=

# ---------- 数据库 ----------
# Docker Compose 部署：只需设置 POSTGRES_PASSWORD，DATABASE_URL 由 compose 自动拼好。
POSTGRES_PASSWORD=
# 本地开发：留空即可，自动使用内嵌的 PGlite（数据在 ./data/pglite）。
# 想连自己的 PostgreSQL 时再填写，例如 postgres://user:pass@localhost:5432/apr
DATABASE_URL=

# ---------- 服务 ----------
# 对外端口（Docker Compose 映射到宿主机的端口 / 本地开发时服务端端口）
PORT=3000
# 本地开发可设为 127.0.0.1，仅允许本机连接；Docker 部署时留空。
HOST=
# 部署在反向代理（Nginx/Caddy 等）之后时设为 1，用于按真实客户端 IP 限速
TRUST_PROXY=

# 仅限本地 / 专用测试环境：true 时开放 /api/test（一键多人测试房间、以任意玩家身份操作、读取完整游戏状态）。
# 公网实例必须留空。
TEST_MODE=

# ---------- AI 主持（全部可选）----------
# 两个密钥都留空 = 无 AI 模式：游戏、题库、计分、房主操作全部正常可用。
# 二选一填写即可；两个都填时默认用 Anthropic，可用 AI_PROVIDER=anthropic|google 指定。
ANTHROPIC_API_KEY=
# 可选：自定义 API 地址（网关/代理）
ANTHROPIC_BASE_URL=
# Google AI Studio 的密钥（https://aistudio.google.com/apikey）
GOOGLE_API_KEY=
GOOGLE_BASE_URL=
AI_PROVIDER=
# 开发用：true = 使用内置的模拟 AI（固定话术，不调用任何模型，无需密钥），用于体验 AI 相关界面
AI_MOCK=false
# 临时关闭 AI 而不删除密钥：false
AI_ENABLED=true
# 模型。留空 = 按提供方取默认值（Anthropic：claude-opus-5-5；Google：gemini-3.8-flash）。
# 填 AI Studio 里显示的模型 ID 即可，例如 gemini-3.8-flash-lite
AI_MODEL=
# 可选：给游戏裁判（海龟汤判定、改编、派对总结）单独指定模型；留空 = 与 AI_MODEL 相同
AI_JUDGE_MODEL=
# 思考力度：low | medium | high（主持闲聊用 low 即可；仅 Anthropic 生效）
AI_EFFORT=low
# 模型拒答时由 API 自动换备用模型重试；使用不支持该参数的网关时设为 false（仅 Anthropic 生效）
AI_REFUSAL_FALLBACK=true
# 用量限制：单次调用超时(ms) / 全局并发 / 每房间每分钟调用数 / 每日调用总数（UTC 日）
AI_TIMEOUT_MS=45000
AI_MAX_CONCURRENCY=2
AI_ROOM_CALLS_PER_MINUTE=6
AI_DAILY_CALL_LIMIT=300
