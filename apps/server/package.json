    "@apr/games": "workspace:*",
    "@apr/shared": "workspace:*",
    "@colyseus/core": "^0.18.28",
    "@colyseus/ws-transport": "^0.18.5",
    "@electric-sql/pglite": "^0.5.16",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
